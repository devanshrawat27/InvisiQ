# Backend Environment Variables
# =============================

# === GOOGLE GEMINI (AI) ===
GEMINI_API_KEY=your-gemini-api-key

# === FIREBASE ===
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# === TWILIO (Optional - SMS Fallback) ===
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# === AUTH ===
# REQUIRED when NODE_ENV=production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# === APP CONFIG ===
PORT=5000
# true = in-memory data + mock AI (no Firebase/Gemini needed)
MOCK_MODE=true
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# === RATE LIMITS (optional, sensible defaults) ===
# Note: students on a campus often share one NAT IP — keep these generous.
LOGIN_RATE_MAX=10        # login attempts per 15 min per IP
JOIN_RATE_MAX=500        # joins per hour per IP
API_RATE_MAX=20000       # API requests per 15 min per IP
